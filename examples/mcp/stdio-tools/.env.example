# examples/mcp/stdio-tools — copy to .env and fill in real values.
#
# crew.lua reaches the environment only through the sandboxed, fail-closed
# env() global: a name resolves ONLY if listed in IRONCREW_ENV_ALLOWLIST
# (bottom of this file). Provider API keys the runtime reads directly
# (Rust-side) do NOT need to be allowlisted.

# Provider API key — read Rust-side, so NOT in the allowlist.
OPENAI_API_KEY=sk-...

# Read by crew.lua via env() — allowlisted below.
PYTHON=python3

IRONCREW_ENV_ALLOWLIST=PYTHON
