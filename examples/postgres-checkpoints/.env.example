# examples/postgres-checkpoints — copy to .env and fill in real values.
#
# crew.lua reaches the environment only through the sandboxed, fail-closed
# env() global: a name resolves ONLY if listed in IRONCREW_ENV_ALLOWLIST
# (bottom of this file). Provider API keys the runtime reads directly
# (Rust-side) do NOT need to be allowlisted.

# Provider API key — read Rust-side, so NOT in the allowlist.
OPENAI_API_KEY=sk-...

# Read by crew.lua via env() — allowlisted below.
OPENAI_MODEL=gpt-5.6-luna

# Dedicated app-data database (separate role/schema from DATABASE_URL, the
# internal StateStore's connection string; never readable from Lua).
IRONCREW_APP_DATABASE_URL=postgres://app_user:secret@localhost:5432/appdata

# Exactly the names crew.lua passes to env(); without them env() returns
# nil and the values above are ignored.
IRONCREW_ENV_ALLOWLIST=OPENAI_MODEL
