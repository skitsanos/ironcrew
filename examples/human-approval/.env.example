# examples/human-approval — copy to .env and fill in real values.

# Provider credentials are read by Rust and do not need to be allowlisted.
OPENAI_API_KEY=sk-...

# crew.lua reads these through env(), so they must be allowlisted.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
IRONCREW_ENV_ALLOWLIST=OPENAI_BASE_URL,OPENAI_MODEL

# Optional human-input tuning:
# IRONCREW_ASK_HUMAN_TIMEOUT=600
# IRONCREW_APPROVAL_TIMEOUT=600
