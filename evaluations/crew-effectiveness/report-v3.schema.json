{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ironcrew.dev/schemas/crew-effectiveness-report-v3.schema.json",
  "title": "IronCrew Crew Effectiveness Report v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "effectiveness_evidence",
    "notice",
    "generated_at",
    "revision",
    "source",
    "binary",
    "dataset",
    "provider",
    "configuration",
    "mock_provider_stats",
    "runs",
    "summary",
    "domain_summary",
    "pairwise",
    "evaluation_plan",
    "pricing",
    "decision",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "ironcrew.crew-eval.v3"
    },
    "mode": {
      "enum": [
        "contract",
        "live"
      ]
    },
    "effectiveness_evidence": {
      "type": "boolean"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "dirty"
      ],
      "properties": {
        "sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "unchanged"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/source_snapshot"
        },
        "end": {
          "$ref": "#/$defs/source_snapshot"
        },
        "unchanged": {
          "const": true
        }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "path_scope",
        "version",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "path_scope": {
          "enum": [
            "repository_relative",
            "external_basename"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "answer_contract",
        "correctness_rule",
        "case_count",
        "aggregate_sha256",
        "oracle_injected_into_prompt",
        "packs"
      ],
      "properties": {
        "name": {
          "const": "grounded-decisions-multipack-v1"
        },
        "answer_contract": {
          "const": "source-visible-single-select-v1"
        },
        "correctness_rule": {
          "const": "exact-option-id-v1"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "aggregate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "oracle_injected_into_prompt": {
          "const": false
        },
        "packs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dataset_pack"
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identity_source",
        "model"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "identity_source": {
          "enum": [
            "evaluator-contract",
            "operator-declared"
          ]
        },
        "model": {
          "const": "gpt-5.6-luna"
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "temperature",
        "reasoning_effort",
        "provider_default_parameters",
        "order_seed",
        "variants",
        "planned_llm_calls_per_run",
        "planned_llm_calls_by_task",
        "planned_max_output_tokens_per_run",
        "planned_max_output_tokens_by_task"
      ],
      "properties": {
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "const": null
        },
        "reasoning_effort": {
          "const": null
        },
        "provider_default_parameters": {
          "const": [
            "reasoning_effort",
            "temperature"
          ]
        },
        "order_seed": {
          "type": "integer"
        },
        "variants": {
          "type": "array",
          "items": [
            {
              "const": "single"
            },
            {
              "const": "dag"
            },
            {
              "const": "collaborative"
            }
          ],
          "additionalItems": false,
          "minItems": 3,
          "maxItems": 3
        },
        "planned_llm_calls_per_run": {
          "const": {
            "single": 1,
            "dag": 3,
            "collaborative": 4
          }
        },
        "planned_llm_calls_by_task": {
          "const": {
            "single": {
              "final": 1
            },
            "dag": {
              "extract": 1,
              "challenge": 1,
              "final": 1
            },
            "collaborative": {
              "discussion": 3,
              "final": 1
            }
          }
        },
        "planned_max_output_tokens_per_run": {
          "const": {
            "single": 800,
            "dag": 1800,
            "collaborative": 2300
          }
        },
        "planned_max_output_tokens_by_task": {
          "const": {
            "single": {
              "final": 800
            },
            "dag": {
              "extract": 500,
              "challenge": 500,
              "final": 800
            },
            "collaborative": {
              "discussion": 1500,
              "final": 800
            }
          }
        }
      }
    },
    "mock_provider_stats": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request_count",
            "requests_by_stage"
          ],
          "properties": {
            "request_count": {
              "type": "integer",
              "minimum": 0
            },
            "requests_by_stage": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "summary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "domain_summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack_id",
          "variants"
        ],
        "properties": {
          "pack_id": {
            "$ref": "#/$defs/pack_id"
          },
          "variants": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/summary"
            }
          }
        }
      }
    },
    "pairwise": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "baseline",
          "paired_count",
          "unique_case_count",
          "mean_grounded_correctness_delta",
          "mean_grounded_correctness_delta_interval",
          "candidate_success_rate",
          "baseline_success_rate",
          "token_pair_count",
          "latency_pair_count",
          "mean_token_multiplier",
          "mean_latency_multiplier",
          "wins",
          "ties",
          "losses"
        ],
        "properties": {
          "candidate": {
            "enum": [
              "dag",
              "collaborative"
            ]
          },
          "baseline": {
            "const": "single"
          },
          "paired_count": {
            "type": "integer",
            "minimum": 0
          },
          "unique_case_count": {
            "type": "integer",
            "minimum": 0
          },
          "mean_grounded_correctness_delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "wins": {
            "type": "integer",
            "minimum": 0
          },
          "ties": {
            "type": "integer",
            "minimum": 0
          },
          "losses": {
            "type": "integer",
            "minimum": 0
          },
          "mean_grounded_correctness_delta_interval": {
            "$ref": "#/$defs/interval"
          },
          "candidate_success_rate": {
            "$ref": "#/$defs/rate"
          },
          "baseline_success_rate": {
            "$ref": "#/$defs/rate"
          },
          "token_pair_count": {
            "type": "integer",
            "minimum": 0
          },
          "latency_pair_count": {
            "type": "integer",
            "minimum": 0
          },
          "mean_token_multiplier": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "mean_latency_multiplier": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "evaluation_plan": {
      "$ref": "#/$defs/evaluation_plan"
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "contract",
        "planned_upper_bound_usd",
        "observed_estimated_upper_bound_usd",
        "coverage_complete",
        "planned_bound_within_budget",
        "observed_estimate_within_budget",
        "estimate_not_invoice",
        "uncached_input_priced_as_cache_write"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "contract": {
          "$ref": "#/$defs/pricing_contract"
        },
        "planned_upper_bound_usd": {
          "$ref": "#/$defs/usd"
        },
        "observed_estimated_upper_bound_usd": {
          "oneOf": [
            {
              "$ref": "#/$defs/usd"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "planned_bound_within_budget": {
          "type": "boolean"
        },
        "observed_estimate_within_budget": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimate_not_invoice": {
          "const": true
        },
        "uncached_input_priced_as_cache_write": {
          "const": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recommended_variant",
        "reason",
        "candidates"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "insufficient_evidence",
            "single_preferred",
            "crew_qualified"
          ]
        },
        "recommended_variant": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "single",
                "dag",
                "collaborative"
              ]
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate",
              "qualified",
              "checks"
            ],
            "properties": {
              "candidate": {
                "enum": [
                  "dag",
                  "collaborative"
                ]
              },
              "qualified": {
                "type": "boolean"
              },
              "checks": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "paired_count",
                  "unique_case_count",
              "candidate_success",
              "baseline_success",
              "token_coverage",
              "latency_coverage",
              "mean_quality_delta",
                  "confidence_lower_bound",
                  "token_multiplier",
                  "latency_multiplier"
                ],
                "properties": {
                  "paired_count": {
                    "type": "boolean"
                  },
                  "unique_case_count": {
                    "type": "boolean"
                  },
                  "candidate_success": {
                    "type": "boolean"
                  },
                  "baseline_success": {
                    "type": "boolean"
                  },
                  "token_coverage": {
                    "type": "boolean"
                  },
                  "latency_coverage": {
                    "type": "boolean"
                  },
                  "mean_quality_delta": {
                    "type": "boolean"
                  },
                  "confidence_lower_bound": {
                    "type": "boolean"
                  },
                  "token_multiplier": {
                    "type": "boolean"
                  },
                  "latency_multiplier": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned_run_count",
        "completed_run_count",
        "budget_abort"
      ],
      "properties": {
        "planned_run_count": {
          "type": "integer",
          "minimum": 1
        },
        "completed_run_count": {
          "type": "integer",
          "minimum": 1
        },
        "budget_abort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "contract"
          }
        }
      },
      "then": {
        "properties": {
          "effectiveness_evidence": {
            "const": false
          },
          "provider": {
            "properties": {
              "name": {
                "const": "synthetic-oracle-backed-mock"
              },
              "identity_source": {
                "const": "evaluator-contract"
              }
            }
          },
          "pricing": {
            "properties": {
              "applicable": {
                "const": false
              },
              "planned_upper_bound_usd": {
                "const": 0
              },
              "observed_estimated_upper_bound_usd": {
                "type": "null"
              },
              "coverage_complete": {
                "const": false
              },
              "planned_bound_within_budget": {
                "const": true
              },
              "observed_estimate_within_budget": {
                "type": "null"
              }
            }
          },
          "decision": {
            "properties": {
              "status": {
                "const": "not_applicable"
              },
              "recommended_variant": {
                "type": "null"
              },
              "candidates": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          }
        }
      },
      "then": {
        "properties": {
          "effectiveness_evidence": {
            "const": true
          },
        "provider": {
          "properties": {
            "name": {
              "const": "openai-api"
            },
            "identity_source": {
              "const": "operator-declared"
            },
            "model": {
              "const": "gpt-5.6-luna"
            }
            }
          },
          "pricing": {
            "properties": {
              "applicable": {
                "const": true
              },
              "planned_upper_bound_usd": {
                "exclusiveMinimum": 0
              },
              "planned_bound_within_budget": {
                "const": true
              }
            }
          },
          "decision": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient_evidence",
                  "single_preferred",
                  "crew_qualified"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          },
          "decision": {
            "properties": {
              "status": {
                "const": "insufficient_evidence"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "recommended_variant": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          },
          "decision": {
            "properties": {
              "status": {
                "const": "single_preferred"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "recommended_variant": {
                "const": "single"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "live"
          },
          "decision": {
            "properties": {
              "status": {
                "const": "crew_qualified"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "recommended_variant": {
                "enum": [
                  "dag",
                  "collaborative"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "source_path_entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source",
            "state"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repository_path"
            },
            "source": {
              "const": "tracked"
            },
            "state": {
              "const": "deleted"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "source",
            "state",
            "bytes",
            "mode",
            "sha256"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/repository_path"
            },
            "source": {
              "enum": [
                "tracked",
                "untracked"
              ]
            },
            "state": {
              "const": "file"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty",
        "tracked_changed_path_count",
        "untracked_path_count",
        "changed_path_count",
        "changed_file_bytes",
        "changed_paths",
        "tracked_diff_sha256",
        "worktree_manifest_sha256",
        "manifest_encoding"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/git_revision"
        },
        "dirty": {
          "type": "boolean"
        },
        "tracked_changed_path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "untracked_path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "changed_path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "changed_file_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870912
        },
        "changed_paths": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/source_path_entry"
          }
        },
        "tracked_diff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "worktree_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_encoding": {
          "const": "sorted compact JSON of revision, tracked_diff_sha256, and changed_paths"
        }
      }
    },
    "dataset_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "pack_version",
        "manifest_path",
        "manifest_sha256",
        "cases_path",
        "cases_sha256",
        "oracle_path",
        "oracle_sha256",
        "case_count",
        "metadata"
      ],
      "properties": {
        "pack_id": {
          "$ref": "#/$defs/pack_id"
        },
        "pack_version": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/repository_path"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "cases_path": {
          "$ref": "#/$defs/repository_path"
        },
        "cases_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "oracle_path": {
          "$ref": "#/$defs/repository_path"
        },
        "oracle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "metadata": {
          "oneOf": [
            {
              "$ref": "#/$defs/domain_pack_metadata"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "manifest_path": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "manifest_sha256": {
                "type": "null"
              },
              "metadata": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "manifest_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "metadata": {
                "$ref": "#/$defs/domain_pack_metadata"
              }
            }
          }
        }
      ]
    },
    "domain_pack_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "intended_use",
        "derivation",
        "oracle_method",
        "independent_review"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1
        },
