{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ironcrew.dev/schemas/crew-effectiveness-report-v1.schema.json",
  "title": "IronCrew Crew Effectiveness Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "effectiveness_evidence",
    "notice",
    "generated_at",
    "revision",
    "binary",
    "dataset",
    "provider",
    "configuration",
    "mock_provider_stats",
    "runs",
    "summary",
    "pairwise"
  ],
  "properties": {
    "schema_version": { "const": "ironcrew.crew-eval.v1" },
    "mode": { "enum": ["contract", "live"] },
    "effectiveness_evidence": { "type": "boolean" },
    "notice": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "dirty"],
      "properties": {
        "sha": { "type": ["string", "null"] },
        "dirty": { "type": "boolean" }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "answer_contract",
        "correctness_rule",
        "case_count",
        "cases_sha256",
        "oracle_sha256",
        "oracle_injected_into_prompt"
      ],
      "properties": {
        "name": { "const": "grounded-decisions-options-v1" },
        "answer_contract": { "const": "source-visible-single-select-v1" },
        "correctness_rule": { "const": "exact-option-id-v1" },
        "case_count": { "type": "integer", "minimum": 1 },
        "cases_sha256": { "$ref": "#/$defs/sha256" },
        "oracle_sha256": { "$ref": "#/$defs/sha256" },
        "oracle_injected_into_prompt": { "const": false }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model"],
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetitions",
        "temperature",
        "order_seed",
        "variants",
        "planned_llm_calls_per_run"
      ],
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1 },
        "temperature": { "const": 0.0 },
        "order_seed": { "type": "integer" },
        "variants": {
          "type": "array",
          "prefixItems": [
            { "const": "single" },
            { "const": "dag" },
            { "const": "collaborative" }
          ],
          "items": false
        },
        "planned_llm_calls_per_run": {
          "const": { "single": 1, "dag": 3, "collaborative": 4 }
        }
      }
    },
    "mock_provider_stats": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["request_count", "requests_by_stage"],
          "properties": {
            "request_count": { "type": "integer", "minimum": 0 },
            "requests_by_stage": {
              "type": "object",
              "additionalProperties": { "type": "integer", "minimum": 0 }
            }
          }
        }
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/run" }
    },
    "summary": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/summary" }
    },
    "pairwise": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate",
          "baseline",
          "paired_count",
          "mean_grounded_correctness_delta",
          "wins",
          "ties",
          "losses"
        ],
        "properties": {
          "candidate": { "enum": ["dag", "collaborative"] },
          "baseline": { "const": "single" },
          "paired_count": { "type": "integer", "minimum": 0 },
          "mean_grounded_correctness_delta": { "type": ["number", "null"] },
          "wins": { "type": "integer", "minimum": 0 },
          "ties": { "type": "integer", "minimum": 0 },
          "losses": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "contract" } } },
      "then": {
        "properties": {
          "effectiveness_evidence": { "const": false },
          "provider": {
            "properties": { "name": { "const": "synthetic-oracle-backed-mock" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "variant",
        "repetition",
        "planned_llm_calls",
        "observed_llm_calls",
        "execution_ok",
        "output_parse_ok",
        "output_schema_ok",
        "failure_reason",
        "client_duration_ms",
        "run_duration_ms",
        "run_id",
        "run_status",
        "total_tokens",
        "cached_tokens",
        "agent_count",
        "task_count",
        "task_names",
        "task_failures",
        "model_output",
        "answers_total",
        "answers_correct",
        "grounded_correct",
        "correctness",
        "grounded_correctness",
        "citation_tp",
        "citation_fp",
        "citation_fn",
        "citation_precision",
        "citation_recall",
        "citation_f1",
        "answer_details"
      ],
      "properties": {
        "case_id": { "type": "string" },
        "variant": { "enum": ["single", "dag", "collaborative"] },
        "repetition": { "type": "integer", "minimum": 0 },
        "planned_llm_calls": { "type": "integer", "minimum": 1 },
        "observed_llm_calls": { "type": ["integer", "null"], "minimum": 0 },
        "execution_ok": { "type": "boolean" },
        "output_parse_ok": { "type": "boolean" },
        "output_schema_ok": { "type": "boolean" },
        "failure_reason": { "type": ["string", "null"] },
        "client_duration_ms": { "type": "integer", "minimum": 0 },
        "run_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "run_id": { "type": ["string", "null"] },
        "run_status": { "type": ["string", "null"] },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 },
        "agent_count": { "type": "integer", "minimum": 0 },
        "task_count": { "type": "integer", "minimum": 0 },
        "task_names": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "task_failures": { "type": "integer", "minimum": 0 },
        "model_output": { "type": ["object", "null"] },
        "answers_total": { "type": "integer", "minimum": 0 },
        "answers_correct": { "type": "integer", "minimum": 0 },
        "grounded_correct": { "type": "integer", "minimum": 0 },
        "correctness": { "$ref": "#/$defs/rate" },
        "grounded_correctness": { "$ref": "#/$defs/rate" },
        "citation_tp": { "type": "integer", "minimum": 0 },
        "citation_fp": { "type": "integer", "minimum": 0 },
        "citation_fn": { "type": "integer", "minimum": 0 },
        "citation_precision": { "$ref": "#/$defs/rate" },
        "citation_recall": { "$ref": "#/$defs/rate" },
        "citation_f1": { "$ref": "#/$defs/rate" },
        "answer_details": { "type": "array", "items": { "type": "object" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "run_count",
        "execution_success_rate",
        "parse_success_rate",
        "schema_success_rate",
        "correctness",
        "grounded_correctness",
        "citation_precision",
        "citation_recall",
        "citation_f1",
        "latency_ms",
        "tokens"
      ],
      "properties": {
        "variant": { "enum": ["single", "dag", "collaborative"] },
        "run_count": { "type": "integer", "minimum": 1 },
        "execution_success_rate": { "$ref": "#/$defs/rate" },
        "parse_success_rate": { "$ref": "#/$defs/rate" },
        "schema_success_rate": { "$ref": "#/$defs/rate" },
        "correctness": { "$ref": "#/$defs/rate" },
        "grounded_correctness": { "$ref": "#/$defs/rate" },
        "citation_precision": { "$ref": "#/$defs/rate" },
        "citation_recall": { "$ref": "#/$defs/rate" },
        "citation_f1": { "$ref": "#/$defs/rate" },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median", "p95"],
          "properties": {
            "median": { "type": ["number", "null"], "minimum": 0 },
            "p95": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median", "total"],
          "properties": {
            "median": { "type": ["number", "null"], "minimum": 0 },
            "total": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
