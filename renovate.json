{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "evaluations/platform-canary/**/*-assembly.Dockerfile"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the release receipt base-image digest in the same refresh as docker/runtime.Dockerfile",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.yml$/"
      ],
      "matchStrings": [
        "BASE_IMAGE_REFERENCE: (?<depName>\\S+)\\n\\s+BASE_IMAGE_INDEX_DIGEST: (?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "minimumReleaseAge": "0 days",
  "rangeStrategy": "bump",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "description": "Keep sse-stream aligned with rmcp 3.4 public transport types",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "sse-stream"
      ],
      "allowedVersions": "<0.3.0"
    },
    {
      "description": "Keep disposable PostgreSQL CI on the moving latest-stable image",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "pinDigests": false
    },
    {
      "description": "Present one dependency refresh for develop instead of a PR queue",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "replacement"
      ],
      "groupName": "dependency refresh",
      "groupSlug": "dependency-refresh"
    },
    {
      "description": "Hold the PostgreSQL floor image at the IronCrew support window (two most recent majors); advance it only in an IronCrew major release",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "allowedVersions": "<18"
    }
  ]
}
